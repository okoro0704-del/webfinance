# -----------------------------------------------------------------------------
# Frontend (apps/dashboard)
# -----------------------------------------------------------------------------
# Project root only — do NOT append /rest/v1 or /auth/v1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# Supabase Edge Functions (set via `supabase secrets set` or functions serve)
# -----------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local/dev: skip real registrar/CF/product APIs
ALLOW_MOCK_INTEGRATIONS=true
REGISTRAR_PROVIDER=mock

# Domain registrar (Namecheap)
# REGISTRAR_PROVIDER=namecheap
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_USERNAME=
# NAMECHEAP_API_BASE=https://api.sandbox.namecheap.com/xml.response

# Domain registrar (ResellerClub)
# REGISTRAR_PROVIDER=resellerclub
RESELLERCLUB_AUTH_USERID=
RESELLERCLUB_API_KEY=
RESELLERCLUB_CUSTOMER_ID=
RESELLERCLUB_CONTACT_ID=

# Cloudflare DNS + SSL
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
ORIGIN_IP=
# OR use CNAME mode / SaaS edge:
ORIGIN_HOSTNAME=edge.webfinance.app
# SSL_MODE=universal | custom_hostname (custom_hostname recommended for external domains)
SSL_MODE=custom_hostname
SAAS_ZONE_NAME=webfinance.app
# SAAS_ZONE_ID=
SAAS_FALLBACK_ORIGIN=edge.webfinance.app
CREATE_WWW_CNAME=false
CF_SSL_VALUE=full

# Repo 1 / Repo 2 tenant handshake
PRODUCT_A_PROVISION_URL=https://mm.webfinance.app
PRODUCT_B_PROVISION_URL=https://pm.webfinance.app
PRODUCT_A_HMAC_SECRET=replace-me
PRODUCT_B_HMAC_SECRET=replace-me
# Fallback shared secret:
TENANT_HMAC_SECRET=replace-me

# Set to "false" to require wallet/license credits on Deploy
DISABLE_DEPLOY_BILLING=true
